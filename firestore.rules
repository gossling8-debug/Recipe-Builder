rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // Each person's own recipes: only they can read and write them.
    match /users/{owner}/{document=**} {
      allow read, write: if signedIn() && uid() == owner;
    }

    // Written only by the server (Cloud Functions). People may read their own
    // plan and AI allowance; Stripe customer ids aren't readable at all.
    match /plans/{owner} {
      allow read: if signedIn() && uid() == owner;
    }
    match /aiUsage/{owner} {
      allow read: if signedIn() && uid() == owner;
    }

    // Family cookbooks. The cookbook's id is the invite code: it's random and
    // only shared by its members, so knowing it is what lets someone join.
    function book(b) { return get(/databases/$(database)/documents/cookbooks/$(b)).data; }
    function isMember(b) { return signedIn() && uid() in book(b).members; }

    match /cookbooks/{b} {
      allow get: if signedIn();
      allow list: if signedIn() && uid() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'names', 'createdAt'])
        && request.resource.data.owner == uid()
        && request.resource.data.members == [uid()]
        && request.resource.data.names.keys().hasOnly([uid()])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      // Only the member list and each person's own display name ever change:
      // join (add yourself), leave (remove yourself; not the owner), or rename yourself.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([uid()])
        && (
          (!(uid() in resource.data.members)
            && request.resource.data.members == resource.data.members.concat([uid()])
            && resource.data.members.size() < 50)
          || (uid() in resource.data.members && uid() != resource.data.owner
            && request.resource.data.members == resource.data.members.removeAll([uid()]))
          || (uid() in resource.data.members && request.resource.data.members == resource.data.members)
        );
      allow delete: if signedIn() && resource.data.owner == uid();

      // The cover page: members read it; the owner edits it.
      match /meta/{m} {
        allow read: if isMember(b);
        allow write: if m == "cover" && signedIn() && book(b).owner == uid()
          && request.resource.data.keys().hasOnly(['subtitle', 'dedication', 'photo', 'photoOnly', 'updatedAt'])
          && request.resource.data.subtitle is string && request.resource.data.subtitle.size() <= 120
          && request.resource.data.dedication is string && request.resource.data.dedication.size() <= 1000
          && (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() < 700000));
        allow delete: if signedIn() && book(b).owner == uid();
      }

      // Memories: members read them and add their own; the author or the owner removes one.
      match /memories/{mem} {
        allow read: if isMember(b);
        allow create: if isMember(b) && request.resource.data.by == uid()
          && request.resource.data.keys().hasOnly(['text', 'photo', 'by', 'byName', 'at', 'recipeId', 'recipeTitle'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000
          && (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() < 700000));
        allow delete: if isMember(b) && (resource.data.by == uid() || book(b).owner == uid());
      }

      // Recipes shared into the cookbook: members read them; each person
      // adds and updates their own; the sharer or the cookbook's owner removes.
      match /recipes/{r} {
        allow read: if isMember(b);
        allow create: if isMember(b) && request.resource.data.sharedBy == uid();
        allow update: if isMember(b) && resource.data.sharedBy == uid() && request.resource.data.sharedBy == uid();
        allow delete: if isMember(b) && (resource.data.sharedBy == uid() || book(b).owner == uid());
      }
    }
  }
}
