rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // Each person's own recipes: only they can read and write them.
    match /users/{owner}/{document=**} {
      allow read, write: if signedIn() && uid() == owner;
    }

    // Written only by the server (Cloud Functions). People may read their own
    // plan and AI allowance; Stripe customer ids aren't readable at all.
    match /plans/{owner} {
      allow read: if signedIn() && uid() == owner;
    }
    match /aiUsage/{owner} {
      allow read: if signedIn() && uid() == owner;
    }

    // The Mix: recipes anyone can publish for everyone signed in. A published
    // recipe has a random id and no account id on it; who published it is kept
    // in mixOwners/{id}, which only that person (and these rules) can read — so
    // an anonymous recipe can't be traced to its cook, or linked to their others.
    // Ratings and reports go through the server (mixVote), which keeps each
    // person's vote private (mixVotes) and puts only totals on the recipe.
    // Admins (admins/{uid}, created by hand) can take any recipe down.
    // (Recipes published before ids were random carried "by" = the cook's id; the deploy moves them.)
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(uid())); }
    match /admins/{a} {
      allow get: if signedIn() && uid() == a;
    }
    // Error reports from the app: a short technical note, no account id or
    // recipe content. Signed-in people can add one; only admins can read them.
    match /errors/{id} {
      allow read, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['message', 'stack', 'screen', 'where', 'app', 'device', 'at', 'expireAt'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 300
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 1500
        && request.resource.data.screen is string && request.resource.data.screen.size() <= 40
        && (request.resource.data.where == null || (request.resource.data.where is string && request.resource.data.where.size() <= 40))
        && request.resource.data.app is string && request.resource.data.app.size() <= 40
        && request.resource.data.device is string && request.resource.data.device.size() <= 200
        && request.resource.data.at is int
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt <= request.time + duration.value(31, 'd');
    }
    function mixOwnerDoc(id) { return /databases/$(database)/documents/mixOwners/$(id); }
    function ownsMix(id) {
      return (exists(mixOwnerDoc(id)) && get(mixOwnerDoc(id)).data.uid == uid())
        || resource.data.get('by', '') == uid();
    }
    function okMixContent(d) {
      return d.recipe is map && d.recipe.title is string && d.recipe.title.size() <= 200
        && d.byName is string && d.byName.size() > 0 && d.byName.size() <= 40
        && d.anonymous is bool
        && (d.sourceUrl == null || (d.sourceUrl is string && d.sourceUrl.size() <= 2000))
        && d.updatedAt is int;
    }
    match /mixOwners/{id} {
      // Only you can see which recipes are yours.
      allow get, list: if signedIn() && resource.data.uid == uid();
      // Claimed in the same write as the recipe, and only for a new id.
      allow create: if signedIn() && request.resource.data.uid == uid()
        && request.resource.data.keys().hasOnly(['uid', 'recipeId'])
        && request.resource.data.recipeId is string
        && !exists(/databases/$(database)/documents/mix/$(id))
        && existsAfter(/databases/$(database)/documents/mix/$(id));
      allow delete: if signedIn() && (resource.data.uid == uid() || isAdmin());
    }
    match /mix/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && getAfter(mixOwnerDoc(id)).data.uid == uid()
        && request.resource.data.keys().hasOnly(['recipe', 'sourceUrl', 'byName', 'anonymous', 'at', 'updatedAt', 'ratingSum', 'ratingCount', 'reportCount'])
        && request.resource.data.ratingSum == 0 && request.resource.data.ratingCount == 0 && request.resource.data.reportCount == 0
        && request.resource.data.at is int
        && okMixContent(request.resource.data);
      // The publisher changes the recipe, its link, their name or whether it's anonymous.
      allow update: if signedIn() && ownsMix(id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recipe', 'sourceUrl', 'byName', 'anonymous', 'updatedAt'])
        && okMixContent(request.resource.data);
      allow delete: if signedIn() && (ownsMix(id) || isAdmin());

      // Older report notes (the deploy moves them into mixVotes).
      match /reports/{r} {
        allow read, delete: if isAdmin();
      }
    }
    // Each person's rating and report of a Mix recipe: written only by the server;
    // only that person (and admins) can read it.
    match /mixVotes/{v} {
      allow get: if signedIn() && (resource == null || resource.data.uid == uid() || isAdmin());
      allow list: if signedIn() && (resource.data.uid == uid() || isAdmin());
    }

    // Family cookbooks. The cookbook's id is the invite code: it's random and
    // only shared by its members, so knowing it is what lets someone join.
    function book(b) { return get(/databases/$(database)/documents/cookbooks/$(b)).data; }
    function isMember(b) { return signedIn() && uid() in book(b).members; }
    // The name a member goes by in this cookbook (so nobody can post under someone else's).
    function myName(b) { return book(b).names.get(uid(), ''); }

    match /cookbooks/{b} {
      allow get: if signedIn();
      allow list: if signedIn() && uid() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'names', 'createdAt'])
        && request.resource.data.owner == uid()
        && request.resource.data.members == [uid()]
        && request.resource.data.names.keys().hasOnly([uid()])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      // Only the member list, each person's own display name and (when the owner
      // leaves) the owner ever change: join (add yourself), leave (remove yourself),
      // or rename yourself. An owner who leaves hands the cookbook to a remaining member.
      // The owner can also rename the cookbook (for everyone).
      allow update: if signedIn() && uid() == resource.data.owner
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'owner'])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([uid()])
        && (
          (request.resource.data.owner == resource.data.owner && (
            (!(uid() in resource.data.members)
              && request.resource.data.members == resource.data.members.concat([uid()])
              && resource.data.members.size() < 50)
            || (uid() in resource.data.members && uid() != resource.data.owner
              && request.resource.data.members == resource.data.members.removeAll([uid()]))
            || (uid() in resource.data.members && request.resource.data.members == resource.data.members)
          ))
          || (uid() == resource.data.owner
            && request.resource.data.members == resource.data.members.removeAll([uid()])
            && request.resource.data.members.size() > 0
            && request.resource.data.owner in request.resource.data.members)
        );
      allow delete: if signedIn() && resource.data.owner == uid();

      // The cover page: members read it; the owner edits it.
      match /meta/{m} {
        allow read: if isMember(b);
        allow write: if m == "cover" && signedIn() && book(b).owner == uid()
          && request.resource.data.keys().hasOnly(['subtitle', 'dedication', 'photo', 'photoOnly', 'updatedAt'])
          && request.resource.data.subtitle is string && request.resource.data.subtitle.size() <= 120
          && request.resource.data.dedication is string && request.resource.data.dedication.size() <= 1000
          && (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() < 700000));
        allow delete: if signedIn() && book(b).owner == uid();
      }

      // Memories: members read them and add their own; the author or the owner removes one.
      match /memories/{mem} {
        allow read: if isMember(b);
        allow create: if isMember(b) && request.resource.data.by == uid()
          && mem.matches(uid() + '_.+')
          && request.resource.data.byName == myName(b)
          && request.resource.data.keys().hasOnly(['text', 'photo', 'photoCount', 'by', 'byName', 'at', 'recipeId', 'recipeTitle'])
          && (!('photoCount' in request.resource.data) || (request.resource.data.photoCount is int && request.resource.data.photoCount <= 10))
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000
          && (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() < 700000));
        allow delete: if isMember(b) && (resource.data.by == uid() || book(b).owner == uid());
      }

      // A memory's photos, one per document: members read them; each person adds their own; the author or the owner removes.
      match /memoryPhotos/{photo} {
        allow read: if isMember(b);
        allow create: if isMember(b) && request.resource.data.by == uid()
          && request.resource.data.keys().hasOnly(['memoryId', 'index', 'data', 'by'])
          && request.resource.data.memoryId is string && request.resource.data.memoryId.matches(uid() + '_.*')
          && request.resource.data.data is string && request.resource.data.data.size() < 700000;
        allow delete: if isMember(b) && (resource.data.by == uid() || book(b).owner == uid());
      }

      // Ratings: one per member per recipe ({recipeId}_{uid}), 1–5 stars. Members read them all;
      // each person sets or clears their own; the owner can also remove any (cleanup).
      match /ratings/{rid} {
        allow read: if isMember(b);
        allow create, update: if isMember(b) && request.resource.data.by == uid()
          && rid == request.resource.data.recipeId + '_' + uid()
          && request.resource.data.keys().hasOnly(['recipeId', 'by', 'byName', 'stars', 'at'])
          && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
          && request.resource.data.byName == myName(b);
        allow delete: if isMember(b) && (resource.data.by == uid() || book(b).owner == uid());
      }

      // Recipes shared into the cookbook: members read them; each person
      // adds their own; the sharer or the cookbook's owner edits or removes one
      // (the owner changes only the recipe itself, never who shared it).
      // A recipe's id starts with its sharer's account id, so nobody can take someone else's id first.
      // Names on it are the sharer's or editor's own in this cookbook (or left as they were).
      function namesOk(b) {
        let d = request.resource.data;
        let was = resource == null ? {} : resource.data;
        return (d.sharedByName == myName(b) || d.sharedByName == was.get('sharedByName', null))
          && (d.get('editedBy', null) == null || d.get('editedBy', null) == uid() || d.get('editedBy', null) == was.get('editedBy', null))
          && (d.get('editedByName', null) == null || d.get('editedByName', null) == myName(b) || d.get('editedByName', null) == was.get('editedByName', null));
      }
      match /recipes/{r} {
        allow read: if isMember(b);
        allow create: if isMember(b) && request.resource.data.sharedBy == uid()
          && r.matches(uid() + '_.+') && request.resource.data.sharedByName == myName(b) && namesOk(b);
        allow update: if isMember(b) && request.resource.data.sharedBy == resource.data.sharedBy && namesOk(b)
          && (resource.data.sharedBy == uid()
            || (book(b).owner == uid()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recipe', 'editedBy', 'editedByName', 'editedAt'])));
        allow delete: if isMember(b) && (resource.data.sharedBy == uid() || book(b).owner == uid());
      }
    }
  
    // Shared shopping lists. The id is the invite code (random, only shared by its
    // members), so knowing it is what lets someone join. Members read and change
    // the list; each person's name is their own.
    function shopList(l) { return get(/databases/$(database)/documents/shoppingLists/$(l)).data; }
    function onShopList(l) { return signedIn() && uid() in shopList(l).members; }
    // Invites by email (a shared shopping list or a cookbook): a member invites
    // someone by the email they use for Cardamix. Only the sender and that
    // person (once they've confirmed the email) can see it.
    match /invites/{i} {
      function mine() {
        return resource.data.fromUid == uid()
          || (request.auth.token.email_verified == true && resource.data.email == request.auth.token.email.lower());
      }
      allow get, list, delete: if signedIn() && mine();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['kind', 'target', 'email', 'fromUid', 'fromName', 'title', 'at'])
        && request.resource.data.fromUid == uid()
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40
        && request.resource.data.title is string && request.resource.data.title.size() <= 60
        && request.resource.data.at is int
        && request.resource.data.target is string
        && ((request.resource.data.kind == 'shop'
              && uid() in get(/databases/$(database)/documents/shoppingLists/$(request.resource.data.target)).data.members)
          || (request.resource.data.kind == 'book'
              && uid() in get(/databases/$(database)/documents/cookbooks/$(request.resource.data.target)).data.members));
    }

    match /shoppingLists/{l} {
      allow get: if signedIn();
      allow list: if signedIn() && uid() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['owner', 'members', 'names', 'createdAt'])
        && request.resource.data.owner == uid()
        && request.resource.data.members == [uid()]
        && request.resource.data.names.keys().hasOnly([uid()])
        && request.resource.data.names[uid()] is string && request.resource.data.names[uid()].size() <= 40;
      // Join (add yourself), leave (take yourself off), or rename yourself; an owner who
      // leaves hands the list to someone still on it.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'owner'])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([uid()])
        && (!(uid() in request.resource.data.names) || (request.resource.data.names[uid()] is string && request.resource.data.names[uid()].size() <= 40))
        && (
          (request.resource.data.owner == resource.data.owner && (
            (!(uid() in resource.data.members)
              && request.resource.data.members == resource.data.members.concat([uid()])
              && resource.data.members.size() < 10)
            || (uid() in resource.data.members && uid() != resource.data.owner
              && request.resource.data.members == resource.data.members.removeAll([uid()]))
            || (uid() in resource.data.members && request.resource.data.members == resource.data.members)
          ))
          || (uid() == resource.data.owner
            && request.resource.data.members == resource.data.members.removeAll([uid()])
            && request.resource.data.members.size() > 0
            && request.resource.data.owner in request.resource.data.members)
        );
      // The last one to leave deletes it.
      allow delete: if signedIn() && resource.data.members == [uid()];

      // Recipes on the list (a copy of their ingredients): members add their own (the id
      // starts with their account id) under their own name, and anyone on the list takes one off.
      match /entries/{e} {
        allow read: if onShopList(l);
        allow create, update: if onShopList(l)
          && e.matches(uid() + '_.+')
          && request.resource.data.keys().hasOnly(['title', 'scale', 'ingredients', 'sourceId', 'addedBy', 'addedByName', 'at'])
          && request.resource.data.addedBy == uid()
          && request.resource.data.addedByName == shopList(l).names[uid()]
          && request.resource.data.title is string && request.resource.data.title.size() <= 200
          && request.resource.data.scale is number
          && request.resource.data.ingredients is list && request.resource.data.ingredients.size() <= 150;
        allow delete: if onShopList(l);
      }
      // What's been ticked off (by whom): anyone on the list ticks and unticks.
      match /ticks/{t} {
        allow read: if onShopList(l);
        allow create, update: if onShopList(l)
          && request.resource.data.keys().hasOnly(['by', 'at'])
          && request.resource.data.by == uid()
          && request.resource.data.at is int;
        allow delete: if onShopList(l);
      }
    }
}
}
