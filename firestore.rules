rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // Each person's own recipes: only they can read and write them.
    match /users/{owner}/{document=**} {
      allow read, write: if signedIn() && uid() == owner;
    }

    // Written only by the server (Cloud Functions). People may read their own
    // plan and AI allowance; Stripe customer ids aren't readable at all.
    match /plans/{owner} {
      allow read: if signedIn() && uid() == owner;
    }
    match /aiUsage/{owner} {
      allow read: if signedIn() && uid() == owner;
    }

    // Family cookbooks. The cookbook's id is the invite code: it's random and
    // only shared by its members, so knowing it is what lets someone join.
    function book(b) { return get(/databases/$(database)/documents/cookbooks/$(b)).data; }
    function isMember(b) { return signedIn() && uid() in book(b).members; }

    match /cookbooks/{b} {
      allow get: if signedIn();
      allow list: if signedIn() && uid() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'owner', 'members', 'names', 'createdAt'])
        && request.resource.data.owner == uid()
        && request.resource.data.members == [uid()]
        && request.resource.data.names.keys().hasOnly([uid()])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      // Only the member list, each person's own display name and (when the owner
      // leaves) the owner ever change: join (add yourself), leave (remove yourself),
      // or rename yourself. An owner who leaves hands the cookbook to a remaining member.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'owner'])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([uid()])
        && (
          (request.resource.data.owner == resource.data.owner && (
            (!(uid() in resource.data.members)
              && request.resource.data.members == resource.data.members.concat([uid()])
              && resource.data.members.size() < 50)
            || (uid() in resource.data.members && uid() != resource.data.owner
              && request.resource.data.members == resource.data.members.removeAll([uid()]))
            || (uid() in resource.data.members && request.resource.data.members == resource.data.members)
          ))
          || (uid() == resource.data.owner
            && request.resource.data.members == resource.data.members.removeAll([uid()])
            && request.resource.data.members.size() > 0
            && request.resource.data.owner in request.resource.data.members)
        );
      allow delete: if signedIn() && resource.data.owner == uid();

      // The cover page: members read it; the owner edits it.
      match /meta/{m} {
        allow read: if isMember(b);
        allow write: if m == "cover" && signedIn() && book(b).owner == uid()
          && request.resource.data.keys().hasOnly(['subtitle', 'dedication', 'photo', 'photoOnly', 'updatedAt'])
          && request.resource.data.subtitle is string && request.resource.data.subtitle.size() <= 120
          && request.resource.data.dedication is string && request.resource.data.dedication.size() <= 1000
          && (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() < 700000));
        allow delete: if signedIn() && book(b).owner == uid();
      }

      // Memories: members read them and add their own; the author or the owner removes one.
      match /memories/{mem} {
        allow read: if isMember(b);
        allow create: if isMember(b) && request.resource.data.by == uid()
          && request.resource.data.keys().hasOnly(['text', 'photo', 'photoCount', 'by', 'byName', 'at', 'recipeId', 'recipeTitle'])
          && (!('photoCount' in request.resource.data) || (request.resource.data.photoCount is int && request.resource.data.photoCount <= 10))
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000
          && (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() < 700000));
        allow delete: if isMember(b) && (resource.data.by == uid() || book(b).owner == uid());
      }

      // A memory's photos, one per document: members read them; each person adds their own; the author or the owner removes.
      match /memoryPhotos/{photo} {
        allow read: if isMember(b);
        allow create: if isMember(b) && request.resource.data.by == uid()
          && request.resource.data.keys().hasOnly(['memoryId', 'index', 'data', 'by'])
          && request.resource.data.memoryId is string && request.resource.data.memoryId.matches(uid() + '_.*')
          && request.resource.data.data is string && request.resource.data.data.size() < 700000;
        allow delete: if isMember(b) && (resource.data.by == uid() || book(b).owner == uid());
      }

      // Ratings: one per member per recipe ({recipeId}_{uid}), 1–5 stars. Members read them all;
      // each person sets or clears their own; the owner can also remove any (cleanup).
      match /ratings/{rid} {
        allow read: if isMember(b);
        allow create, update: if isMember(b) && request.resource.data.by == uid()
          && rid == request.resource.data.recipeId + '_' + uid()
          && request.resource.data.keys().hasOnly(['recipeId', 'by', 'byName', 'stars', 'at'])
          && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
          && request.resource.data.byName is string && request.resource.data.byName.size() <= 60;
        allow delete: if isMember(b) && (resource.data.by == uid() || book(b).owner == uid());
      }

      // Recipes shared into the cookbook: members read them; each person
      // adds their own; the sharer or the cookbook's owner edits or removes one
      // (the owner changes only the recipe itself, never who shared it).
      match /recipes/{r} {
        allow read: if isMember(b);
        allow create: if isMember(b) && request.resource.data.sharedBy == uid();
        allow update: if isMember(b) && request.resource.data.sharedBy == resource.data.sharedBy
          && (resource.data.sharedBy == uid()
            || (book(b).owner == uid()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recipe', 'editedBy', 'editedByName', 'editedAt'])));
        allow delete: if isMember(b) && (resource.data.sharedBy == uid() || book(b).owner == uid());
      }
    }
  }
}
